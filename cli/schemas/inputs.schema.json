{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:inputs",
  "title": "InferYard inputs v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "evidence_layout_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "documents": {
      "type": "object",
      "properties": {
        "run": {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "payload",
            "sha256"
          ],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "payload",
            "sha256"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "payload",
            "sha256"
          ],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "payload",
            "sha256"
          ],
          "additionalProperties": false
        },
        "bundle": {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "payload",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run",
        "plan",
        "selection",
        "config",
        "bundle"
      ],
      "additionalProperties": false
    },
    "configuration_source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string",
              "enum": [
                "application/json",
                "application/toml"
              ]
            },
            "encoding": {
              "type": "string",
              "enum": [
                "base64"
              ]
            },
            "content": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "media_type",
            "encoding",
            "content",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration_source_missing_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "evidence_layout_version",
    "run_id",
    "documents",
    "configuration_source",
    "configuration_source_missing_reason"
  ],
  "additionalProperties": false
}
