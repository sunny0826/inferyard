{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:engine_check",
  "title": "InferYard engine_check v3",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "enum": [
        "engine check"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "checked",
        "blocked",
        "error",
        "interrupted"
      ]
    },
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "run_id": {
      "type": "null"
    },
    "evidence_dir": {
      "type": "null"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "invalid_input",
          "unsupported_platform",
          "engine_version_query_failed",
          "package_resource_invalid",
          "io_error",
          "internal_error",
          "cancelled"
        ]
      },
      "minItems": 0
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "invalid_library_manifest",
                    "unsupported_engine_build_requires_adapter_validation",
                    "unsupported_runtime_profile",
                    "runtime_receipt_invalid",
                    "runtime_profile_mismatch",
                    "runtime_asset_mismatch"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reported_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_release": {
              "type": "string",
              "minLength": 1
            },
            "modes": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": "boolean"
                    },
                    "metal": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "cpu",
                    "metal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "cpu",
                    "cuda"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "eligible",
            "reason",
            "reported_version",
            "expected_release",
            "modes",
            "mode"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "eligible": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "null"
                  },
                  "reported_version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "type": "null"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "modes": {
                          "type": "object",
                          "properties": {
                            "cpu": {
                              "type": "boolean"
                            },
                            "metal": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "cpu",
                            "metal"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": [
                            "cpu",
                            "cuda"
                          ]
                        },
                        "modes": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              },
              "else": {
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "invalid_library_manifest",
                      "unsupported_engine_build_requires_adapter_validation",
                      "unsupported_runtime_profile",
                      "runtime_receipt_invalid",
                      "runtime_profile_mismatch",
                      "runtime_asset_mismatch"
                    ]
                  },
                  "reported_version": {
                    "type": "null"
                  },
                  "modes": {
                    "type": "null"
                  },
                  "mode": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "command",
    "status",
    "completeness",
    "run_id",
    "evidence_dir",
    "limitations",
    "details"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "checked"
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "const": "complete"
          },
          "details": {
            "type": "object",
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "invalid_library_manifest",
                      "unsupported_engine_build_requires_adapter_validation",
                      "unsupported_runtime_profile",
                      "runtime_receipt_invalid",
                      "runtime_profile_mismatch",
                      "runtime_asset_mismatch"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reported_version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_release": {
                "type": "string",
                "minLength": 1
              },
              "modes": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "cpu": {
                        "type": "boolean"
                      },
                      "metal": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "cpu",
                      "metal"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "cuda"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "eligible",
              "reason",
              "reported_version",
              "expected_release",
              "modes",
              "mode"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "eligible": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "type": "null"
                    },
                    "reported_version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "mode": {
                            "type": "null"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "modes": {
                            "type": "object",
                            "properties": {
                              "cpu": {
                                "type": "boolean"
                              },
                              "metal": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "cpu",
                              "metal"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "cpu",
                              "cuda"
                            ]
                          },
                          "modes": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  ]
                },
                "else": {
                  "properties": {
                    "reason": {
                      "type": "string",
                      "enum": [
                        "invalid_library_manifest",
                        "unsupported_engine_build_requires_adapter_validation",
                        "unsupported_runtime_profile",
                        "runtime_receipt_invalid",
                        "runtime_profile_mismatch",
                        "runtime_asset_mismatch"
                      ]
                    },
                    "reported_version": {
                      "type": "null"
                    },
                    "modes": {
                      "type": "null"
                    },
                    "mode": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "completeness": {
            "const": "incomplete"
          },
          "details": {
            "type": "null"
          }
        }
      }
    }
  ]
}
