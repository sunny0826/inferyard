{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:sample",
  "title": "InferYard sample v3",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 3
        },
        "experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "clock_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "utc": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "probe",
            "warmup",
            "baseline",
            "formal",
            "scoring",
            "residual",
            "finalizing"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_name": {
          "type": "string",
          "enum": [
            "system_mem_available",
            "service_rss"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "bytes"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "read_started_ns": {
          "type": "integer",
          "minimum": 0
        },
        "read_finished_ns": {
          "type": "integer",
          "minimum": 0
        },
        "server_pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "process_start_ticks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "experiment_id",
        "trial_id",
        "run_id",
        "seq",
        "clock_id",
        "utc",
        "phase",
        "request_id",
        "metric_name",
        "value",
        "unit",
        "source",
        "read_started_ns",
        "read_finished_ns",
        "server_pid",
        "process_start_ticks",
        "missing_reason"
      ],
      "additionalProperties": false
    },
