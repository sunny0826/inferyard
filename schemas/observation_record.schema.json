  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 3
        },
        "evidence_layout_version": {
          "type": "integer",
          "const": 2
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "parent"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "prepare"
          ]
        },
        "key": {
          "type": "null"
        },
        "clock_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "utc": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "evidence_layout_version",
        "run_id",
        "trial_id",
        "seq",
        "kind",
        "stage",
        "key",
        "clock_id",
        "monotonic_ns",
        "utc",
        "payload",
        "payload_sha256"
      ],
      "additionalProperties": false
    },
