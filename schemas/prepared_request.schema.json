{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:prepared_request",
  "title": "InferYard prepared_request v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "evidence_layout_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "probe",
        "warmup",
        "formal"
      ]
    },
    "body": {
      "type": "object"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "evidence_layout_version",
    "run_id",
    "trial_id",
    "request_id",
    "ordinal",
    "phase",
    "body",
    "body_sha256"
  ],
  "additionalProperties": false
}
