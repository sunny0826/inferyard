        },
        "tolerance_ratio": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "max_wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_guard_gap_ns": {
          "type": "integer",
          "minimum": 1
        },
        "tool_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "guardian_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "definition",
        "case_ids",
        "tolerance_ratio",
        "max_wall_seconds",
        "max_guard_gap_ns",
        "tool_source_sha256",
        "config_sha256",
