{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:total_observer_control",
  "title": "InferYard total_observer_control v3",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 3
        },
        "definition": {
          "type": "string",
          "enum": [
            "total_observer_control.v1"
          ]
        },
        "case_ids": {
          "type": "array",
