{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:metric_observation",
  "title": "InferYard metric_observation v3",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 3
        },
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "definition_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "type": "object",
          "properties": {
            "workload_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "category": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_category": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "workload_id",
            "category",
            "error_category"
          ],
          "additionalProperties": false
        },
        "statistic": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "request",
            "process",
            "device",
            "engine",
            "host",
            "experiment"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "missing",
            "not_applicable"
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "sampled_start_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sampled_end_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_eligible": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "metric_id",
        "definition_version",
        "run_id",
        "trial_id",
        "request_id",
        "group",
        "statistic",
        "value",
        "unit",
        "layer",
        "source",
        "status",
        "missing_reason",
        "sample_count",
        "numerator",
        "denominator",
        "excluded",
        "sampled_start_ns",
        "sampled_end_ns",
        "coverage_ratio",
        "comparison_eligible",
        "limitations",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
