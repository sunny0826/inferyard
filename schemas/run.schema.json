{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ai-bench:schema:v3:run",
  "title": "InferYard run v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "check",
        "run"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "single",
        "experiment"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "measured",
        "migrated"
      ]
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "initial",
        "repeat",
        "resume",
        "rerun",
        "derived"
      ]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "tool_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "definition_versions": {
      "type": "object",
      "properties": {
        "measurement": {
          "type": "string",
          "minLength": 1
        },
        "scoring": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "measurement",
        "scoring",
        "comparison"
      ],
      "additionalProperties": false
    },
    "resumed_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0
    },
    "diagnostic": {
      "type": "boolean"
    },
    "implementation_identity": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "enum": [
            "implementation-identity.v1"
          ]
        },
        "measurement": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "sha256",
            "files",
            "dependencies"
          ],
          "additionalProperties": false
        },
        "scoring": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "sha256",
            "files",
            "dependencies"
          ],
          "additionalProperties": false
        },
        "presentation": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "sha256",
            "files",
            "dependencies"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "definition",
        "measurement",
        "scoring",
        "presentation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "execution_mode",
    "origin",
    "experiment_id",
    "trial_id",
    "plan_sha256",
    "parent_run_id",
    "relation",
    "tool_version",
    "tool_source_sha256",
    "definition_versions",
    "resumed_case_ids",
    "diagnostic"
  ],
  "additionalProperties": false
}
