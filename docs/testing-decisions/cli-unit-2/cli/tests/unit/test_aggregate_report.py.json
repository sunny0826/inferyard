    },
    {
      "test": "test_frozen_recipe_mismatch_blocks_controlled_differences",
      "decision": "keep",
      "reason": "冻结生成、执行及环境任一配方差异都阻止控制差值，避免将混杂因素归因模型。"
    },
    {
      "test": "test_identically_unknown_identity_never_becomes_comparable",
