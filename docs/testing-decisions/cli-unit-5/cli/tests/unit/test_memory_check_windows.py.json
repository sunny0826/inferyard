    },
    {
      "test": "test_groups_use_file_owner_session_never_name_and_redact_identity",
      "decision": "keep",
      "reason": "同名不同文件/账户/session不得合并，RSS与private分别求和并脱敏身份，避免错误释放估计和泄露路径。"
    },
    {
      "test": "test_identity_reuse_discards_both_measurements",
      "decision": "keep",
      "reason": "PID启动、账户或session中途变化必须丢弃两种内存测量，避免把其他进程内存挂到旧身份。"
    },
    {
      "test": "test_inaccessible_and_exited_keep_rows",
      "decision": "keep",
      "reason": "权限不足或退出仍保留缺测行与原因，避免进程消失并高估覆盖率。"
    },
    {
      "test": "test_owner_missing_preserves_memory_without_group_or_recommendation",
      "decision": "keep",
      "reason": "所有者读不到时内存仍可显示但不分组或推荐，避免错误建议关闭未知应用。"
    },
    {
      "test": "test_parent_reuse_does_not_discard_own_memory_or_propagate_protection",
      "decision": "keep",
      "reason": "父PID复用不丢子进程自身内存也不继承保护，避免错误依赖关系。"
    },
    {
      "test": "test_partial_private_measurement_keeps_working_set_and_total_null",
      "decision": "keep",
      "reason": "部分private缺测时RSS仍有总量、private总量为null及已知值，不能低估真实占用。"
    },
    {
      "test": "test_protections_and_verified_descendants",
      "decision": "keep",
      "reason": "安全软件、agent、SSH、系统session/账户/路径及可信子进程须保护，避免建议关闭关键进程。"
    },
    {
      "test": "test_security_name_under_system_root_protects_descendants",
      "decision": "keep",
      "reason": "系统目录内安全软件仍保护其子进程，避免路径分类遮蔽安全软件身份。"
