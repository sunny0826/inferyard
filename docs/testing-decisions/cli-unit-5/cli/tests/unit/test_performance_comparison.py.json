    },
    {
      "test": "test_different_model_tokenizer_blocks_rate_but_not_task_e2e",
      "decision": "keep",
      "reason": "模型tokenizer不同可比任务总耗时但不可比token速率，避免不等工作量比较。"
    },
    {
