{
  "source_path": "studio/internal/core/engine_owner_recovery_test.go",
  "decisions": [
    {
      "test": "TestDiscardOrphanRecordAllowsRestart",
      "decision": "keep",
      "reason": "损坏、不可读身份、启动后遗留及清理失败四种记录可显式仅删记录，不发信号并解除新启动阻塞。"
    },
    {
      "test": "TestDiscardOrphanRecordRechecksReplacedRecord",
      "decision": "keep",
      "reason": "确认前记录从坏文件恢复为匹配活进程时必须重新拒绝删除，防依据旧状态删掉当前 owner。"
    },
    {
      "test": "TestDiscardOrphanRecordRejectsMatchingIdentity",
      "decision": "keep",
      "reason": "当前身份匹配或权限恢复后已匹配的活进程不能仅删记录绕过显式停止，防活进程失去归属。"
    },
    {
      "test": "TestDiscardOrphanRecordRespectsActiveWork",
      "decision": "keep",
      "reason": "运行中、正在停止或 closing 时不能清 owner，防任务仍依赖服务时丢失归属或再启动。"
    },
    {
      "test": "TestManagedEngineCleanupFailureCanRecover",
      "decision": "keep",
      "reason": "实际受管引擎停止后 owner 损坏要进入恢复入口，显式清除后可重启，防用户永久无法再启动。"
    }
  ]
}
