      "reason": "inspect/idle 的慢流体也受总期限约束，避免预检持续卡住。"
    },
    {
      "test": "test_invalid_auth_header_never_reaches_httpx",
      "decision": "keep",
      "reason": "非法 API key 字符在建客户端时拒绝，避免传输层异常泄露凭据。"
    },
    {
      "test": "test_invalid_metrics_fail_closed",
      "decision": "keep",
      "reason": "重复、非有限、负数或非法标签的指标拒绝，避免坏数据证明空闲。"
    },
    {
      "test": "test_invalid_request_never_sent",
      "decision": "keep",
      "reason": "非法 token、超时或空 prompt 在网络请求前拒绝，避免带无效冻结参数发请求。"
    },
    {
      "test": "test_invalid_usage_is_not_silently_discarded",
      "decision": "keep",
