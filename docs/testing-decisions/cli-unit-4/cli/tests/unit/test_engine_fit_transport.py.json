    },
    {
      "test": "test_inspect_rejects_multiple_models_or_aliases_before_version_probe",
      "decision": "keep",
      "reason": "同时加载目标与别名或 LoRA 时拒绝，防止多实例请求来源不明。"
    },
    {
      "test": "test_inspect_rejects_unverified_version",
      "decision": "keep",
      "reason": "版本缺失、类型错误或含自由文本时拒绝，防止未核实引擎进入比较。"
    },
    {
      "test": "test_inspection_deadline_applies_to_streamed_bodies",
