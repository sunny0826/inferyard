    },
    {
      "test": "test_corrupt_primary_marker_never_disappears",
      "decision": "keep",
      "reason": "恢复八类标记文件参数；损坏、数组、重复键、NaN 都不能被识别器忽略后降级验收。"
    },
    {
      "test": "test_dispatch_preserves_dedicated_result_and_request",
