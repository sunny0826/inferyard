    },
    {
      "test": "test_path_is_required_and_must_be_a_directory",
      "decision": "keep",
      "reason": "缺路径、普通文件或不存在目录须拒绝，避免误报离线核验成功。"
    },
    {
      "test": "test_public_source_and_config_preserve_mismatch_and_readiness",
      "decision": "keep",
      "reason": "公开包投影匹配仍不表示运行就绪；线程配置变化须返回 mismatch 与退出码 3。"
    },
    {
      "test": "test_public_source_projection_is_checked_before_configuration",
      "decision": "keep",
      "reason": "来源模型不同必须拒绝公开投影，不能用配置匹配掩盖错误来源；不限制内部校验顺序。",
      "renamed_to": "test_public_source_mismatch_cannot_be_hidden_by_matching_configuration"
