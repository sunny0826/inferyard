    },
    {
      "test": "test_extension_symlinks_cannot_escape_artifact_root",
      "decision": "keep",
      "reason": "packet 与 manifest 的外部符号链接都被拒绝，防止读取产物根之外的证据。"
    },
    {
      "test": "test_overhead_retains_specialized_refusal_exit_codes",
      "decision": "keep",
      "reason": "目标、环境或三类计时评估不合格时 verify 必须保留 not_passed 与退出码 3。"
    },
    {
      "test": "test_packet_marker_with_no_metadata_uses_extension_failure",
