{
  "version": 2,
  "include": [
    "cli/src/*",
    "studio/*.go",
    "studio/internal/*"
  ],
  "exclude": [
    "studio/build/*",
    "studio/dist/*",
    "studio/*_test.go",
    "studio/internal/*_test.go"
  ],
  "third_party_modules": [],
  "checkers": {
    "structure.guarded_projection": {"enabled": false},
    "function_size": {"enabled": false},
    "test.integrity": {"enabled": false},
    "test.deletion": {"enabled": false},
    "flow.handling": {"enabled": false},
    "type.contract": {"enabled": false},
    "type.annotation": {"enabled": false},
    "type.signature": {"enabled": false},
    "type.broad": {"enabled": false},
    "type.boundary": {"enabled": false},
    "unused.parameter": {"enabled": false},
    "unused.function": {"enabled": false},
    "unused.field": {"enabled": false},
    "unused.return": {"enabled": false},
    "type.assertion": {"enabled": false},
    "type.suppression": {"enabled": false},
    "imports.wildcard": {"enabled": false},
    "architecture.owner": {"enabled": false},
    "architecture.structure": {"enabled": false},
    "architecture.dispatch": {"enabled": false},
    "architecture.object_model": {"enabled": false},
    "architecture.import": {
      "boundaries": [
        {
          "name": "business modules do not depend on the CLI layer",
          "sources": [
            "cli/src/inferyard/contracts/*",
            "cli/src/inferyard/config/*",
            "cli/src/inferyard/runtime/*",
            "cli/src/inferyard/adapters/*",
            "cli/src/inferyard/evidence/*",
            "cli/src/inferyard/analysis/*",
            "cli/src/inferyard/reporting/*",
            "cli/src/inferyard/platforms/*",
            "cli/src/inferyard/extensions/*",
            "cli/src/inferyard/provisioning/*"
          ],
          "forbidden_imports": ["inferyard.cli", "inferyard.cli.*"]
        }
      ]
    }
  }
}
